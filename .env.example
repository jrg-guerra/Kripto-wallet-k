# Copia este archivo como ".env" y pega TÚ MISMO tus credenciales.
# IMPORTANTE: crea la API key en Binance con SOLO el permiso "Enable Reading".
# NO habilites trading ni retiros. Nadie más que este script local la lee.
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui

# --- Bot de Telegram (opcional) --------------------------------------------
# Notificaciones al móvil y consultas de solo lectura. El bot NUNCA opera.
# 1) Crea el bot con @BotFather (/newbot) y copia el token.
# 2) Escríbele un mensaje al bot, luego abre
#    https://api.telegram.org/bot<TOKEN>/getUpdates y busca "chat":{"id":...
# 3) Pega ambos valores acá. Sin CHAT_ID el bot no responde a nadie.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Login del bot (opcional pero recomendado). NO se guardan usuario ni clave:
# se guarda un hash scrypt de ambos juntos. Generalo con:
#     node src/telegram.mjs --login
# Con esto configurado el bot arranca BLOQUEADO: no responde NADA hasta recibir
# /login <usuario> <clave>. El desbloqueo dura 30 min, el mensaje con las
# credenciales se borra al instante, y 3 fallos congelan toda la ejecución.
TELEGRAM_PASS=

# --- Consejero (opcional) ---------------------------------------------------
# Deja que Claude REDACTE borradores sobre lo que ya pasó: veredictos de
# jugadas cerradas, contradicciones entre hipótesis, y el argumento en contra
# de una oferta antes de aprobarla.
#
# NUNCA decide ni ejecuta: la compuerta de riesgo sigue siendo código
# determinista. Un modelo de lenguaje falla "diciendo OK con buena prosa", que
# es la peor clase posible de control.
#
# Sin esta key el sistema funciona igual; solo quedan inertes /api/consejero/*.
# Se saca de https://console.anthropic.com/settings/keys — pégala tú mismo.
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Por defecto claude-sonnet-5, porque la tarea es de
# juicio y no de resumen. Con estos volúmenes el costo son centavos al mes.
KW_MODELO=
